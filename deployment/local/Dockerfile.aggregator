# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for tools/aggregator/cmd/aggregator — the rebuildable
# read-projection ingester (ledger scan → judicial classify → Postgres).
#
# The binary is fully env-driven (clitools.Config + TOOLS_* overrides) and
# self-migrating (the projection schema is embedded), so the same image runs
# under docker-compose or k8s; only the injected env + DB differ.
#
# Build from the repo root:
#   docker build -f deployment/local/Dockerfile.aggregator .
#
# Behind a TLS-inspecting egress proxy (CI sandbox / corporate net), pass the
# trust bundle so module + package fetches verify (no-op when absent):
#   docker build -f deployment/local/Dockerfile.aggregator \
#     --secret id=ca_bundle,src=/etc/ssl/certs/ca-certificates.crt .
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder
# Cross-compile from the native build platform to TARGETOS/TARGETARCH (set by
# buildx) — no QEMU-emulated compilation. CGO is off, so this is a pure
# cross-compile and stays fast for arm64 on an amd64 runner.
ARG TARGETOS TARGETARCH

WORKDIR /src

COPY go.mod go.sum ./

# All deps are public (baseproof SDK + attesta-tools/libs), so no VCS auth is
# needed. The optional ca_bundle secret trusts a TLS-inspecting proxy's CA;
# cache mounts speed re-builds without bloating the final image.
RUN --mount=type=secret,id=ca_bundle \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    if [ -s /run/secrets/ca_bundle ]; then \
      cat /run/secrets/ca_bundle >> /etc/ssl/certs/ca-certificates.crt; \
    fi; \
    go mod download

COPY . .

# Static, reproducible binary: CGO off (no glibc shim), -trimpath strips local
# paths, -buildvcs=false avoids requiring the .git dir in the build context.
ARG VERSION=docker
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath -buildvcs=false \
    -ldflags "-X main.Version=${VERSION}" \
    -o /aggregator ./tools/aggregator/cmd/aggregator

# ── Runtime ────────────────────────────────────────────────────
# Pinned base (not :latest) for reproducible, auditable rebuilds.
FROM alpine:3.21

RUN --mount=type=secret,id=ca_bundle \
    if [ -s /run/secrets/ca_bundle ]; then \
      cat /run/secrets/ca_bundle >> /etc/ssl/certs/ca-certificates.crt; \
    fi; \
    apk --no-cache add ca-certificates tzdata wget \
    && adduser -D -H -u 65532 aggregator

WORKDIR /
COPY --from=builder /aggregator /aggregator

# Non-root: the aggregator reads the public ledger + writes its own projection
# DB; it holds no signing keys.
USER 65532:65532

EXPOSE 8092

# Liveness over plain HTTP — the aggregator's probe surface needs no client cert.
HEALTHCHECK --interval=5s --timeout=3s --retries=10 --start-period=3s \
    CMD wget -q -O- http://localhost:8092/healthz >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/aggregator"]
