# Multi-stage Dockerfile for cmd/network-api (the JN Smart-Edge auditor).
# Built from the JN repo root (context: ../..).
#
# The binary is fully env-driven (api/config.ApplyEnvOverrides) — the same
# image runs under docker-compose (this dir) or k8s, configured only by env +
# mounted Secret/ConfigMap files. No config file is baked in.
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-X main.Version=0.0.1" \
    -o /network-api ./cmd/network-api

FROM alpine:latest
RUN apk --no-cache add ca-certificates tzdata wget

WORKDIR /
COPY --from=builder /network-api /network-api

EXPOSE 8443
ENTRYPOINT ["/network-api"]
