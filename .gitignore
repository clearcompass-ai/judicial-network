# --- General ---
# Ignore dot-directories anywhere (e.g., .git/, .vscode/, .idea/, .pytest_cache/)
**/.*/
# But allow .githooks (pre-commit hooks shared via repo)
!.githooks/
!.githooks/**
# ...and .github (CI workflows, issue templates — project config, tracked)
!.github/
!.github/**
# --- Environment Variables & Secrets ---
# Ignore env files by default...
.env
.env.*
env.*

# Ignore plaintext image-warmer env (anywhere)
**/image-warmer.env

# But keep the encrypted SOPS version tracked (anywhere)
!**/image-warmer.env.sops

# Allow BOTH dot-prefixed and non-dot-prefixed encrypted env files anywhere EXCEPT inside dot-directories
!**/.env.enc
**/.*/.env.enc
!**/env.enc
**/.*/env.enc

# Allow example files and SOPS config (wherever they are), still subject to dot-directory ignore above
!**/.env.example
!**/env.example
!**/.sops.yaml

# --- Byte-compiled/optimized/DLL files ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual Environment ---
venv/
.venv/
env/
.env/
*env/
*env.bak/
*env.old/
# The e2e harness's Go package e2e/internal/env is NOT a Python virtualenv / env
# file. Three patterns above silently swallow it from `git add`: env/ + *env/
# (the dir) and env.* (line ~14, the env.go file). Un-ignore the dir, then the
# file, so the harness's run-bridge package is tracked.
!e2e/internal/env/
!e2e/internal/env/env.go

# --- Application Outputs & Logs ---
.outputs/
logs/
*.log
*.log.*
output.txt
output*.txt
artifacts/test/

# --- IDE/Editor Configurations ---
# Note: dot-directories are already handled by **/.*/
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Build, Distribution, and Packaging Artifacts ---

dist/
*.egg-info/
pip-wheel-metadata/
/site/
*.egg
/wheels/
# Local debug runs — MHTML, screenshots, JSON output
.run/
# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
pytest-report.html

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Docker ---
docker-compose.override.yml
docker-compose.local.yml

# --- Terraform & OpenTofu ---
.terraform/
.tofu/
terraform.tfstate
terraform.tfstate.backup
tofu.tfstate
tofu.tfstate.backup
*.tfvars
*.tfplan
.terraform.lock.hcl
.tofu.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Go / Golang ---
*.exe
*.dll
*.so
*.dylib
*.test
/bin
/pkg
/vendor/

# --- Node.js / npm / yarn ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# --- Other ---
.python-version
*.pem
*.key
*.duckdb
*.csv
secrets.yml

# --- SOPS/Age Private Keys (Safety Net) ---
keys.txt
*age-key.txt
# --- Stray root-level Go build artifacts ---
# Canonical builds go to ./bin/ (ignored above). These guard against an
# accidental `go build ./cmd/<x>` writing the binary to the repo root.
# Anchored with a leading slash so they never match the source dirs
# (cmd/network-api/, tools/aggregator/, …). NOTE: /e2e is intentionally
# omitted — e2e/ is the harness SOURCE directory.
/network-api
/judicial-cli
/court-tools
/provider-tools
/aggregator
/add-destination-fields
/verify-destination
